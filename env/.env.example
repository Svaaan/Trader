# Copy to env/.env and fill in.

# Nothing here is required: every setting below has a working default, and
# training needs no account and no network beyond the price fetch.

# --- the panel -------------------------------------------------------------
#
# Which symbols to build from: core (10, for iterating on code), us, europe,
# or wide (241, the default for a real run).
#
# Width is not about having more rows. A macro feature is identical across
# every symbol on the day it lands, so on ten names a CPI print is one
# observation; on hundreds it is hundreds of observations of which companies
# react and how. See src/trader/universe.py.
TRADER_UNIVERSE=wide

# --- optional: prose in the background panel -------------------------------
#
# The reading panel on /analysis cites its sources either way. With a key and
# `pip install anthropic` it also writes them up in sentences.
#
# Nothing in the model, the features, or the score depends on this. The
# reading layer sits downstream of the measurement and cannot reach it, which
# is the same seam drawn around order execution.
# ANTHROPIC_API_KEY=

# --- where things are cached -----------------------------------------------
#
# Defaults are all under data/. Set these only to move them.
# TRADER_CACHE=          # daily prices, as CSV you can read
# TRADER_EVENT_CACHE=    # earnings calendars
# TRADER_NEWS=           # the point-in-time news store -- append-only
# TRADER_RUNS=           # one directory per run
